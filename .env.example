# =============================================================================
# .env.example - Plantilla de configuracion del kit portable
# =============================================================================
# Copiar este archivo como .env en la raiz del proyecto:
#   copy .env.example .env
#
# .env NO se versiona (esta en .gitignore). El lanzador scripts\lanzar_v6_lab.bat
# lee este archivo linea a linea con formato CLAVE=VALOR (sin 'export', sin
# comillas, sin espacios alrededor de '='). Las lineas que empiezan por # se
# ignoran. Las variables IDS_* del lanzador tienen prioridad sobre este archivo.
# =============================================================================

# --- Motor v6 (produccion en la rama ml-v6; el lanzador fija los valores) -----
# scripts\lanzar_v6_produccion.bat usa estos mismos flags y manda sobre .env.
IDS_ML_V6=1
IDS_ML_SOMBRA=0
IDS_ML_ALERTAS=0
IDS_IPS_AUTONOMO=0
IDS_RUN_ID=prod-v6-activo
IDS_AUTO_INICIAR=1
IDS_MODO_OBSERVACION=0

# --- Laboratorio v6 (run separado; no es el lanzador por defecto) -------------
# IDS_RUN_ID=lab-v6-activo

# --- Captura -----------------------------------------------------------------
# Vacio = el motor elige la interfaz por defecto. Para forzar la NIC del SPAN,
# poner el nombre exacto que muestra Scapy (p. ej. Ethernet).
IDS_IFACE=
IDS_HOSTS_GESTION=172.10.0.57,172.10.0.59

# --- Persistencia ------------------------------------------------------------
IDS_DB_PATH=intrusiones_v5.db
LOG_FOLDER=logs_ciberseguridad

# --- Telegram (dejar vacio para NO enviar alertas) ---------------------------
# Se leen desde telegram_alert.py. Si se dejan vacios se usa el valor de
# desarrollo incluido en el codigo; en una PC nueva conviene definirlos.
IDS_TELEGRAM_TOKEN=
IDS_TELEGRAM_CHAT_IDS=

# --- MikroTik (solo si IDS_IPS_AUTONOMO=1; en el laboratorio va en 0) ---------
MIKROTIK_PROFILE=lab
MIKROTIK_IP=
MIKROTIK_USER=
MIKROTIK_PASS=
MIKROTIK_PORT=22
MIKROTIK_ADDRESS_LIST=IDS_BLACKLIST
